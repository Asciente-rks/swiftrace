# SwiftRace backend — local & deployment environment template.
# In CI these come from GitHub Secrets / Variables (see .github/workflows/deploy-backend.yml).
# Locally, copy this to .env and fill in the values for `npm run seed` / `npm run clear`.

# Region the table + lambda live in.
AWS_REGION=ap-southeast-1

# Local-only AWS credentials (CI uses GitHub OIDC / Action secrets).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DynamoDB table — must match the table name the deploy workflow provisions.
LOGISTICS_DYNAMO_TABLE=swiftrace-logistics
SHIPMENT_DYNAMO_TABLE=swiftrace-logistics

# Auth.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Outbound tracking emails.
EMAIL_USER=
EMAIL_PASS=

# Default origin warehouse for sample-order seeded shipments.
DEFAULT_ORIGIN=Warehouse
