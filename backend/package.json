{
  "name": "swiftrace-backend",
  "version": "0.2.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "package": "node build.mjs && cd dist && zip -j function.zip index.js",
    "deploy": "npm run package && bash scripts/deploy.sh",
    "seed": "ts-node seed.ts",
    "clear": "ts-node clear.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-sdk": "^2.1693.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/dotenv": "^6.1.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^6.4.7",
    "esbuild": "^0.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
